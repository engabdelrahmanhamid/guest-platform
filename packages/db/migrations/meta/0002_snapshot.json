      "checkConstraints": {
        "events_name_len": {
          "name": "events_name_len",
          "value": "char_length(\"events\".\"name\") BETWEEN 1 AND 150"
        },
        "events_city_len": {
          "name": "events_city_len",
          "value": "char_length(\"events\".\"city\") BETWEEN 1 AND 80"
        },
        "events_venue_len": {
          "name": "events_venue_len",
          "value": "char_length(\"events\".\"venue_name\") BETWEEN 1 AND 150"
        },
        "events_address_len": {
          "name": "events_address_len",
          "value": "\"events\".\"address\" IS NULL OR char_length(\"events\".\"address\") <= 300"
        },
        "events_description_len": {
          "name": "events_description_len",
          "value": "\"events\".\"description\" IS NULL OR char_length(\"events\".\"description\") <= 1000"
        },
        "events_maps_url_format": {
          "name": "events_maps_url_format",
          "value": "\"events\".\"maps_url\" IS NULL OR (\"events\".\"maps_url\" ~ '^https?://' AND char_length(\"events\".\"maps_url\") <= 500)"
        },
        "events_ends_after_starts": {
          "name": "events_ends_after_starts",
          "value": "\"events\".\"ends_at\" IS NULL OR \"events\".\"ends_at\" > \"events\".\"starts_at\""
        },
        "events_companions_range": {
          "name": "events_companions_range",
          "value": "\"events\".\"default_allowed_companions\" BETWEEN 0 AND 20"
        },
        "events_category_type": {
          "name": "events_category_type",
          "value": "(\"events\".\"category\" = 'private' AND \"events\".\"type\" IN ('wedding','malka','engagement','graduation','birthday','private_dinner','other'))\n       OR (\"events\".\"category\" = 'business' AND \"events\".\"type\" IN ('conference','corporate','product_launch','opening','ceremony','exhibition','other'))"
        },
        "events_opens_offset_range": {
          "name": "events_opens_offset_range",
          "value": "\"events\".\"checkin_opens_offset_min\" BETWEEN -10080 AND 0"
        },
        "events_duration_range": {
          "name": "events_duration_range",
          "value": "\"events\".\"assumed_duration_min\" BETWEEN 30 AND 4320"
        },
        "events_closes_offset_range": {
          "name": "events_closes_offset_range",
          "value": "\"events\".\"checkin_closes_offset_min\" BETWEEN 0 AND 4320"
        },
        "events_reopen_window_range": {
          "name": "events_reopen_window_range",
          "value": "\"events\".\"reopen_window_min\" BETWEEN 0 AND 10080"
        },
        "events_published_when_not_draft": {
          "name": "events_published_when_not_draft",
          "value": "\"events\".\"status\" = 'draft' OR \"events\".\"published_at\" IS NOT NULL"
        },
        "events_live_at_when_live": {
          "name": "events_live_at_when_live",
          "value": "\"events\".\"status\" <> 'live' OR \"events\".\"live_at\" IS NOT NULL"
        },
        "events_completed_at_when_completed": {
          "name": "events_completed_at_when_completed",
          "value": "\"events\".\"status\" <> 'completed' OR \"events\".\"completed_at\" IS NOT NULL"
        },
        "events_cancellation_consistent": {
          "name": "events_cancellation_consistent",
          "value": "(\"events\".\"cancelled_at\" IS NULL) = (\"events\".\"cancellation_reason\" IS NULL)\n       AND (\"events\".\"status\" <> 'cancelled' OR \"events\".\"cancelled_at\" IS NOT NULL)"
        },
        "events_cancellation_reason_len": {
          "name": "events_cancellation_reason_len",
          "value": "\"events\".\"cancellation_reason\" IS NULL OR char_length(\"events\".\"cancellation_reason\") BETWEEN 1 AND 500"
        },
        "events_archived_at_when_archived": {
          "name": "events_archived_at_when_archived",
          "value": "\"events\".\"status\" <> 'archived' OR \"events\".\"archived_at\" IS NOT NULL"
        },
        "events_disabled_consistent": {
          "name": "events_disabled_consistent",
          "value": "(\"events\".\"disabled_at\" IS NULL) = (\"events\".\"disabled_reason\" IS NULL)"
        }
      },
      "isRLSEnabled": false
