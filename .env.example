# Copy to .env for local development. Never commit real values.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://guest_platform:guest_platform@localhost:5432/guest_platform
LOG_LEVEL=info
# Encrypts secrets at rest (admin two-factor keys). Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Error tracking. Leave empty until a provider is chosen; guest personal data must never be sent.
ERROR_TRACKING_DSN=
# Worker health endpoint port (GET /health).
WORKER_HEALTH_PORT=8081
