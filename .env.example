# Copy to .env for local development. Never commit real values.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://guest_platform:guest_platform@localhost:5432/guest_platform
LOG_LEVEL=info
# Encrypts secrets at rest (admin two-factor keys). Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Reverse proxies in front of the web app that append to X-Forwarded-For (0 = reached directly).
# The client address is taken that many places from the right, so a client-supplied header is
# ignored. Your proxy must append to the header, never pass it through unchanged.
TRUSTED_PROXY_HOPS=1
# Error tracking. Leave empty until a provider is chosen; guest personal data must never be sent.
ERROR_TRACKING_DSN=
# Worker health endpoint port (GET /health).
WORKER_HEALTH_PORT=8081
# Event images (cover, logo). Production needs an S3-compatible bucket in the Saudi region;
# development stores files under LOCAL_STORAGE_DIR. The bucket stays private: the app serves
# images itself, so credentials and bucket URLs never reach a browser.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Account email (verification, password reset) to owners and admins, never guests. Required in
# production; any SMTP provider hosted in the Saudi region works. Development keeps mail in
# memory at /dev/outbox and ignores these.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
